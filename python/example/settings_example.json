{
    "parse": {
        "vcdGlob": "./example/dummy-vivado.vcd",
        "signalPropertiesFile": "./example/signal_properties.pickle"
    },
    "synthesize": {
        "pickleGlob": "./example/dummy-vivado.pickle",
        "signalsFileName": "./example/signals.json",
        "signalPropertiesFile": "./example/signal_properties.pickle",
        "leakageModel": "HammingDistance",
        "window": false,
        "windowFrom": null,
        "windowTo": null,
        "valueExtractFunction": "valueExtractIndex",
        "writeTraces": true,
        "writeTracesBatchSize": 10,
        "traceFileName": "./example/traces.h5",
        "allign": false,
        "downsample": 1e5,
        "format": "lascar"
    },
    "analyze": {
        "traceFileName": "./example/traces.h5",
        "value_signal_fixed": [
            1
        ]
    }
}